{
	# La demo usa una CA local. Su instalación en el equipo es explícita.
	skip_install_trust
	admin off
	auto_https disable_redirects
}
{$KODA_SITE:localhost:8443} {
	bind {$KODA_BIND:127.0.0.1}
	encode gzip
	request_body {
		max_size 6MB
	}
	header X-Content-Type-Options nosniff
	reverse_proxy 127.0.0.1:{$KODA_BACKEND_PORT:4321} {
		header_up -Forwarded
		header_up -X-Forwarded-Port
	}
}
