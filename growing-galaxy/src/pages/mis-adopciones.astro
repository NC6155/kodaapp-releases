
---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import { db } from "../lib/db";
import { getUsuarioDesdeSesion } from "../lib/auth";
import "../styles/postulaciones.css";

export const prerender = false;

// Evitar almacenar información privada en caché.
Astro.response.headers.set(
  "Cache-Control",
  "private, no-store"
);

// Validar sesión.
const usuario = await getUsuarioDesdeSesion(
  Astro.cookies.get("session_id")?.value
);

if (!usuario) {
  return Astro.redirect("/login");
}

// Solo pueden acceder los adoptantes.
if (usuario.tipo_usuario !== "adoptante") {
  return Astro.redirect("/gestion");
}

// Consultar únicamente las adopciones
// del adoptante autenticado.
const resultado = await db.query(
  `SELECT
     p.id,
     p.mascota_id,
     p.resuelta_en,
     p.fin_tenencia,
     p.motivo_fin_tenencia,
     m.nombre AS mascota_nombre,
     m.tipo_mascota,
     u.nombre AS organizacion_nombre
   FROM postulaciones p
   JOIN mascotas m
     ON m.id = p.mascota_id
   JOIN usuarios u
     ON u.id = m.usuario_id
   WHERE p.adoptante_id = $1
     AND p.estado = 'aprobada'
   ORDER BY
     p.resuelta_en DESC NULLS LAST,
     p.id DESC`,
  [usuario.id]
);

const historial = resultado.rows;

// Contadores.
const total = historial.length;

const vigentes = historial.filter(
  (adopcion) => adopcion.fin_tenencia === null
).length;

const finalizadas = historial.filter(
  (adopcion) => adopcion.fin_tenencia !== null
).length;

// Filtros disponibles.
const filtrosValidos = [
  "todas",
  "vigentes",
  "finalizadas"
];

const filtroURL = Astro.url.searchParams.get("estado");

const filtroActual =
  filtroURL && filtrosValidos.includes(filtroURL)
    ? filtroURL
    : "todas";

// Filtrar los registros.
const historialFiltrado = historial.filter((adopcion) => {
  if (filtroActual === "vigentes") {
    return adopcion.fin_tenencia === null;
  }

  if (filtroActual === "finalizadas") {
    return adopcion.fin_tenencia !== null;
  }

  return true;
});

// Formato de fechas para Chile.
const fechaHora = (valor: Date | string | null) => {
  if (!valor) return "Sin fecha registrada";

  return new Date(valor).toLocaleString("es-CL", {
    timeZone: "America/Santiago",
    day: "2-digit",
    month: "long",
    year: "numeric",
    hour: "2-digit",
    minute: "2-digit",
    hour12: false
  });
};
---

<Layout
  title="Mis adopciones | KodaApp"
  description="Consulta tu historial de adopciones."
>
  <Header />

  <main class="post-page">
    <div class="post-container">

      <!-- ENCABEZADO -->
      <div class="post-heading">

        <a href="/usuario" class="back-link">
          <i class="fa-solid fa-arrow-left"></i>
          Volver a mi cuenta
        </a>

        <span class="section-kicker">
          Mi historial
        </span>

        <h1>Mis adopciones</h1>

        <p>
          Consulta las mascotas que actualmente tienes
          a tu cargo y aquellas que adoptaste
          anteriormente.
        </p>

      </div>

      <!-- CONTADORES -->
      <section
        class="historial-resumen"
        aria-label="Resumen de adopciones"
      >

        <div class="post-entry">
          <p>Total de adopciones</p>
          <strong>{total}</strong>
        </div>

        <div class="post-entry">
          <p>Tenencias vigentes</p>
          <strong class="contador-vigente">
            {vigentes}
          </strong>
        </div>

        <div class="post-entry">
          <p>Tenencias finalizadas</p>
          <strong>{finalizadas}</strong>
        </div>

      </section>

      <!-- FILTROS -->
      <nav
        class="historial-filtros"
        aria-label="Filtrar mis adopciones"
      >

        <a
          href="?estado=todas"
          class:list={[
            "historial-filtro",
            { activo: filtroActual === "todas" }
          ]}
        >
          Todas ({total})
        </a>

        <a
          href="?estado=vigentes"
          class:list={[
            "historial-filtro",
            { activo: filtroActual === "vigentes" }
          ]}
        >
          Vigentes ({vigentes})
        </a>

        <a
          href="?estado=finalizadas"
          class:list={[
            "historial-filtro",
            { activo: filtroActual === "finalizadas" }
          ]}
        >
          Finalizadas ({finalizadas})
        </a>

      </nav>

      <!-- HISTORIAL DE ADOPCIONES -->
      {
        historialFiltrado.length === 0 ? (
          <div class="post-empty">

            <i class="fa-solid fa-clock-rotate-left"></i>

            <h2>
              {total === 0
                ? "Todavía no tienes adopciones"
                : "No hay adopciones en este filtro"}
            </h2>

            <p>
              {total === 0
                ? "Cuando una de tus postulaciones sea aprobada, aparecerá en esta sección."
                : "Puedes seleccionar otro filtro para consultar tus adopciones."}
            </p>

          </div>
        ) : (
          <div class="post-list">

            {historialFiltrado.map((adopcion) => (
              <article class="post-entry">

                <span
                  class:list={[
                    "post-status",
                    {
                      "is-aprobada":
                        !adopcion.fin_tenencia,

                      "is-finalizada":
                        !!adopcion.fin_tenencia
                    }
                  ]}
                >
                  {adopcion.fin_tenencia
                    ? "Tenencia finalizada"
                    : "Tenencia vigente"}
                </span>

                <h2>{adopcion.mascota_nombre}</h2>

                <p>
                  <strong>Organización:</strong>
                  {" "}
                  {adopcion.organizacion_nombre}
                </p>

                <p>
                  <strong>Fecha de adopción:</strong>
                  {" "}
                  {fechaHora(adopcion.resuelta_en)}
                </p>

                {
                  adopcion.fin_tenencia ? (
                    <>
                      <p>
                        <strong>
                          Fecha de finalización:
                        </strong>
                        {" "}
                        {fechaHora(adopcion.fin_tenencia)}
                      </p>

                      <div class="post-detail">

                        <strong>
                          Motivo de finalización
                        </strong>

                        <p>
                          {adopcion.motivo_fin_tenencia?.trim()
                            || "Sin motivo registrado."}
                        </p>

                      </div>
                    </>
                  ) : (
                    <p class="post-date">
                      Actualmente tienes esta mascota
                      a tu cargo.
                    </p>
                  )
                }

              </article>
            ))}

          </div>
        )
      }

    </div>
  </main>
</Layout>

<style>
  .historial-resumen {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    margin-bottom: 25px;
  }

  .historial-resumen strong {
    display: block;
    font-size: 32px;
    font-weight: 900;
    margin-top: 8px;
  }

  .contador-vigente {
    color: var(--success);
  }

  .historial-filtros {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 25px;
  }

  .historial-filtro {
    padding: 10px 18px;
    border-radius: 10px;
    border: 1px solid var(--border-light);
    background: var(--surface);
    color: var(--text);
    text-decoration: none;
    font-weight: 700;
  }

  .historial-filtro.activo {
    background: var(--cyan-soft);
    border-color: var(--cyan);
    color: var(--cyan);
  }

  .post-status.is-finalizada {
    background: var(--bg-soft);
    color: var(--muted);
  }

  .post-detail {
    overflow-wrap: anywhere;
  }

  @media (max-width: 600px) {
    .historial-resumen {
      grid-template-columns: 1fr;
    }
  }
</style>
