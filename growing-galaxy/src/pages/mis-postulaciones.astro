
---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import { db } from "../lib/db";
import { getUsuarioDesdeSesion } from "../lib/auth";
import "../styles/postulaciones.css";

export const prerender = false;

const usuario = await getUsuarioDesdeSesion(
  Astro.cookies.get("session_id")?.value
);

if (!usuario) {
  return Astro.redirect("/login");
}

if (usuario.tipo_usuario !== "adoptante") {
  return Astro.redirect("/gestion");
}

const resultado = await db.query(
  `SELECT
     p.id,
     p.mascota_id,
     p.estado, p.fin_tenencia,
     p.creada_en,
     p.resuelta_en,
     m.nombre AS mascota_nombre,
     m.tipo_mascota,
     u.nombre AS organizacion_nombre
   FROM postulaciones p
   JOIN mascotas m
     ON m.id = p.mascota_id
   JOIN usuarios u
     ON u.id = m.usuario_id
   WHERE p.adoptante_id = $1
   ORDER BY p.creada_en DESC`,
  [usuario.id]
);

    const postulaciones = resultado.rows;

    const MAX_PENDIENTES = 3;
    const MAX_DIARIAS = 3;

    const consultaCupos = await db.query(
      `SELECT
        COUNT(*) FILTER (
          WHERE estado = 'pendiente'
        )::integer AS pendientes,

        COUNT(*) FILTER (
          WHERE
            (creada_en AT TIME ZONE 'America/Santiago')::date =
            (NOW() AT TIME ZONE 'America/Santiago')::date
        )::integer AS enviadas_hoy

      FROM postulaciones
      WHERE adoptante_id = $1`,
      [usuario.id]
    );

    const pendientes = Number(
      consultaCupos.rows[0]?.pendientes ?? 0
    );

    const enviadasHoy = Number(
      consultaCupos.rows[0]?.enviadas_hoy ?? 0
    );


const fechaHora = (valor: Date | string) => {
  return new Date(valor).toLocaleString("es-CL", {
    timeZone: "America/Santiago",
    day: "2-digit",
    month: "long",
    year: "numeric",
    hour: "2-digit",
    minute: "2-digit",
    hour12: false
  });
};

    function mostrarEstado(postulacion: {
      estado: string;
      fin_tenencia: Date | string | null;
    }) {
      if (
        postulacion.estado === "aprobada" &&
        postulacion.fin_tenencia
      ) {
        return "Tenencia finalizada";
      }

      const nombres: Record<string, string> = {
        pendiente: "Pendiente de evaluación",
        aprobada: "Adopción vigente",
        rechazada: "Postulación rechazada",
        cancelada: "Postulación retirada"
      };

      return nombres[postulacion.estado] ?? postulacion.estado;
    }

---

<Layout
  title="Mis postulaciones | KodaApp"
  description="Consulta el estado de tus postulaciones de adopción."
>
  <Header />

  <main class="post-page">
    <div class="post-container">

      <div class="post-heading">
        <a href="/usuario" class="back-link">
          <i class="fa-solid fa-arrow-left"></i>
          Volver a mi cuenta
        </a>

        <span class="section-kicker">
          Mi proceso
        </span>

        <h1>Mis postulaciones</h1>

        <p>
          Aquí puedes consultar las solicitudes que
          has enviado a las organizaciones.
        </p>
      </div>

        <!-- RESUMEN DE CUPOS -->

        <section class="resumen-cupos">
          <h2>Resumen de mis postulaciones</h2>

          <div class="resumen-cupos-grid">

            <div class="cupo-card">
              <span>Postulaciones pendientes</span>

              <strong>
                {pendientes} de {MAX_PENDIENTES}
              </strong>

              <progress
                value={Math.min(pendientes, MAX_PENDIENTES)}
                max={MAX_PENDIENTES}
              ></progress>

              <small>
                Las solicitudes rechazadas o retiradas
                liberan este cupo.
              </small>
            </div>

            <div class="cupo-card">
              <span>Postulaciones enviadas hoy</span>

              <strong>
                {enviadasHoy} de {MAX_DIARIAS}
              </strong>

              <progress
                value={Math.min(enviadasHoy, MAX_DIARIAS)}
                max={MAX_DIARIAS}
              ></progress>

              <small>
                Se reinicia cada día según la hora de Chile.
              </small>
            </div>

          </div>

          {(pendientes >= MAX_PENDIENTES ||
            enviadasHoy >= MAX_DIARIAS) && (
            <p class="cupo-aviso" role="status">
              <i class="fa-solid fa-circle-info"></i>

              {enviadasHoy >= MAX_DIARIAS
                ? "Alcanzaste el límite diario. Podrás volver a postular mañana, siempre que tengas cupos disponibles."
                : "Ya tienes tres solicitudes pendientes. Espera una respuesta o retira una postulación."}
            </p>
          )}
        </section>


      {
        postulaciones.length === 0 ? (
          <section class="post-empty">
            <i class="fa-solid fa-paw"></i>

            <h2>Aún no tienes postulaciones</h2>

            <p>
              Explora las mascotas disponibles
              y envía tu primera solicitud.
            </p>

            <a href="/usuario" class="btn-primary">
              Ver mascotas disponibles
            </a>
          </section>
        ) : (
          <div class="post-list">
            {postulaciones.map((postulacion) => (
              <article class="post-entry">

                <span
                  class={`post-status is-${postulacion.estado}`}
                >
                  {mostrarEstado(postulacion)}
                </span>

                <h2>{postulacion.mascota_nombre}</h2>

                <p>
                  <strong>Organización:</strong>
                  {" "}
                  {postulacion.organizacion_nombre}
                </p>

                <p>
                  <strong>Tipo de mascota:</strong>
                  {" "}
                  {postulacion.tipo_mascota}
                </p>

                <p class="post-date">
                  Enviada el:
                  {" "}
                  {fechaHora(postulacion.creada_en)}
                </p>

                {
                  postulacion.estado === "pendiente" && (
                    <p>
                      Tu solicitud está esperando
                      la evaluación de la organización.
                    </p>
                  )
                }

                {
                  postulacion.estado === "aprobada" && (
                    <p>
                      {postulacion.fin_tenencia ? `Tenencia cerrada el ${fechaHora(postulacion.fin_tenencia)}.` : "La adopción está activa y ocupa un cupo."}
                    </p>
                  )
                }

                {
                  postulacion.estado === "rechazada" && (
                    <p>
                      Tu postulación no fue aprobada.
                      Puedes explorar otras mascotas
                      disponibles en KodaApp.
                    </p>
                  )
                }

                <div class="post-entry-actions">
                {postulacion.estado === "pendiente" && (
                  <button
                    type="button"
                    class="btn-secondary retirar-postulacion"
                    data-id={postulacion.id}
                  >
                    <i class="fa-solid fa-xmark"></i>
                    Retirar postulación
                  </button>
                )}
                  <a
                    href={`/postular/${postulacion.mascota_id}`}
                    class="btn-secondary"
                  >
                    Ver mascota
                  </a>
                </div>

                <a href={`/reportar/${postulacion.id}`}>Reportar un incidente</a>
              </article>
            ))}
          </div>
        )
      }

    </div>
  </main>
</Layout>

<script>
  document
    .querySelectorAll<HTMLButtonElement>(".retirar-postulacion")
    .forEach((boton) => {
      boton.addEventListener("click", async () => {
        if (!confirm(
          "¿Deseas retirar esta postulación? " +
          "Seguirá contando para el límite diario."
        )) return;

        boton.disabled = true;

        try {
          const respuesta = await fetch(
            "/api/postulaciones/cancelar",
            {
              method: "POST",
              credentials: "same-origin",
              headers: {
                "Content-Type": "application/json"
              },
              body: JSON.stringify({
                id: Number(boton.dataset.id)
              })
            }
          );

          const resultado = await respuesta.json();

          if (!respuesta.ok || !resultado.ok) {
            throw new Error(resultado.mensaje);
          }

          // Actualiza el historial y los contadores.
          window.location.reload();

        } catch (error) {
          boton.disabled = false;
          alert(
            error instanceof Error
              ? error.message
              : "No se pudo retirar la solicitud."
          );
        }
      });
    });
</script>



<style>
  .resumen-cupos {
    margin: 28px 0;
  }

  .resumen-cupos h2 {
    margin-bottom: 18px;
    font-size: 21px;
    color: #fff;
  }

  .resumen-cupos-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
  }

  .cupo-card {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 24px;
    background: #242d38;
    border: 1px solid #465365;
    border-radius: 16px;
    color: #fff;
  }

  .cupo-card span {
    color: #c6cbd3;
    font-size: 14px;
  }

  .cupo-card strong {
    font-size: 30px;
  }

  .cupo-card progress {
    width: 100%;
    height: 10px;
    accent-color: #ff6b4a;
  }

  .cupo-card small {
    color: #acb6c4;
    line-height: 1.5;
  }

  .cupo-aviso {
    margin-top: 15px;
    padding: 13px 16px;
    border: 1px solid #846644;
    background: #393025;
    border-radius: 10px;
    color: #ffd9a6;
  }

  .cupo-aviso i {
    margin-right: 8px;
  }

  @media (max-width: 600px) {
    .resumen-cupos-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
