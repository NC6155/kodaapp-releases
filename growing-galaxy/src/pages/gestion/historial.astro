
---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import { db } from "../../lib/db";
import { getUsuarioDesdeSesion } from "../../lib/auth";
import "../../styles/postulaciones.css";

export const prerender = false;

// Evitar almacenar información privada en caché.
Astro.response.headers.set("Cache-Control", "private, no-store");

// Validar sesión.
const usuario = await getUsuarioDesdeSesion(
  Astro.cookies.get("session_id")?.value
);

if (!usuario) {
  return Astro.redirect("/login");
}

// Solo pueden acceder las organizaciones.
if (usuario.tipo_usuario !== "organizacion") {
  return Astro.redirect("/usuario");
}

// Consultar las adopciones de las mascotas
// pertenecientes a la organización autenticada.
const resultado = await db.query(
  `SELECT
     p.id,
     p.mascota_id,
     p.resuelta_en,
     p.fin_tenencia,
     p.motivo_fin_tenencia,
     m.nombre AS mascota_nombre,
     u.nombre AS adoptante_nombre
   FROM postulaciones p
   JOIN mascotas m
     ON m.id = p.mascota_id
   JOIN usuarios u
     ON u.id = p.adoptante_id
   WHERE m.usuario_id = $1
     AND p.estado = 'aprobada'
   ORDER BY p.resuelta_en DESC NULLS LAST, p.id DESC`,
  [usuario.id]
);

const historial = resultado.rows;

// Contadores.
const total = historial.length;

const vigentes = historial.filter(
  (adopcion) => adopcion.fin_tenencia === null
).length;

const finalizadas = historial.filter(
  (adopcion) => adopcion.fin_tenencia !== null
).length;

// Filtros del historial.
const filtrosValidos = [
  "todas",
  "vigentes",
  "finalizadas"
];

const filtroURL = Astro.url.searchParams.get("estado");

const filtroActual =
  filtroURL && filtrosValidos.includes(filtroURL)
    ? filtroURL
    : "todas";

const historialFiltrado = historial.filter((adopcion) => {
  if (filtroActual === "vigentes") {
    return adopcion.fin_tenencia === null;
  }

  if (filtroActual === "finalizadas") {
    return adopcion.fin_tenencia !== null;
  }

  return true;
});

const fechaHora = (valor: Date | string | null) => {
  if (!valor) return "Sin fecha registrada";

  return new Date(valor).toLocaleString("es-CL", {
    timeZone: "America/Santiago",
    day: "2-digit",
    month: "long",
    year: "numeric",
    hour: "2-digit",
    minute: "2-digit",
    hour12: false
  });
};
---

<Layout
  title="Historial de adopciones | KodaApp"
  description="Consulta el historial de adopciones de tus mascotas."
>
  <Header />

  <main class="post-page">
    <div class="post-container">

      <div class="post-heading">

        <a href="/gestion" class="back-link">
          <i class="fa-solid fa-arrow-left"></i>
          Volver a gestión
        </a>

        <span class="section-kicker">
          Panel de organización
        </span>

        <h1>Historial de adopciones</h1>

        <p>
          Consulta las adopciones vigentes y finalizadas
          de las mascotas de tu organización.
        </p>

      </div>

      <!-- Contadores -->
      <section class="historial-resumen">

        <div class="post-entry">
          <p>Total de adopciones</p>
          <strong>{total}</strong>
        </div>

        <div class="post-entry">
          <p>Tenencias vigentes</p>
          <strong class="contador-vigente">
            {vigentes}
          </strong>
        </div>

        <div class="post-entry">
          <p>Tenencias finalizadas</p>
          <strong>{finalizadas}</strong>
        </div>

      </section>

      <!-- Filtros -->
      <nav class="historial-filtros" aria-label="Filtrar adopciones">

        <a
          href="?estado=todas"
          class:list={[
            "historial-filtro",
            { activo: filtroActual === "todas" }
          ]}
        >
          Todas ({total})
        </a>

        <a
          href="?estado=vigentes"
          class:list={[
            "historial-filtro",
            { activo: filtroActual === "vigentes" }
          ]}
        >
          Vigentes ({vigentes})
        </a>

        <a
          href="?estado=finalizadas"
          class:list={[
            "historial-filtro",
            { activo: filtroActual === "finalizadas" }
          ]}
        >
          Finalizadas ({finalizadas})
        </a>

      </nav>

      <!-- Historial -->
      {
        historialFiltrado.length === 0 ? (
          <div class="post-empty">
            <i class="fa-solid fa-clock-rotate-left"></i>

            <h2>No hay adopciones para mostrar</h2>

            <p>
              Las adopciones correspondientes a este
              filtro aparecerán aquí.
            </p>
          </div>
        ) : (
          <div class="post-list">

            {historialFiltrado.map((adopcion) => (
              <article class="post-entry">

                <span
                  class:list={[
                    "post-status",
                    {
                      "is-aprobada": !adopcion.fin_tenencia,
                      "is-finalizada": !!adopcion.fin_tenencia
                    }
                  ]}
                >
                  {adopcion.fin_tenencia
                    ? "Tenencia finalizada"
                    : "Tenencia vigente"}
                </span>

                <h2>{adopcion.mascota_nombre}</h2>

                <p>
                  <strong>Adoptante:</strong>
                  {" "}
                  {adopcion.adoptante_nombre}
                </p>

                <p>
                  <strong>Fecha de adopción:</strong>
                  {" "}
                  {fechaHora(adopcion.resuelta_en)}
                </p>

                {
                  adopcion.fin_tenencia ? (
                    <>
                      <p>
                        <strong>Fecha de finalización:</strong>
                        {" "}
                        {fechaHora(adopcion.fin_tenencia)}
                      </p>

                      <div class="post-detail">
                        <strong>Motivo de finalización</strong>

                        <p>
                          {adopcion.motivo_fin_tenencia?.trim()
                            || "Sin motivo registrado."}
                        </p>
                      </div>
                    </>
                  ) : (
                    <p class="post-date">
                      La mascota mantiene una tenencia activa.
                    </p>
                  )
                }

              </article>
            ))}

          </div>
        )
      }

    </div>
  </main>
</Layout>

<style>
  .historial-resumen {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    margin-bottom: 25px;
  }

  .historial-resumen strong {
    display: block;
    font-size: 32px;
    font-weight: 900;
    margin-top: 8px;
  }

  .contador-vigente {
    color: var(--success);
  }

  .historial-filtros {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 25px;
  }

  .historial-filtro {
    padding: 10px 18px;
    border-radius: 10px;
    border: 1px solid var(--border-light);
    background: var(--surface);
    color: var(--text);
    text-decoration: none;
    font-weight: 700;
  }

  .historial-filtro.activo {
    background: var(--cyan-soft);
    border-color: var(--cyan);
    color: var(--cyan);
  }

  .post-status.is-finalizada {
    background: var(--bg-soft);
    color: var(--muted);
  }

  @media (max-width: 600px) {
    .historial-resumen {
      grid-template-columns: 1fr;
    }
  }
</style>
