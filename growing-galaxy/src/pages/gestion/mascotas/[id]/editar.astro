
---
/**
 * KODAPP - EDITAR MASCOTA
 *
 * Solo permite editar las publicaciones
 * pertenecientes a la organización conectada.
 */

import Layout from "../../../../layouts/Layout.astro";
import Header from "../../../../components/Header.astro";
import ClasificacionMascota from "../../../../components/ClasificacionMascota.astro";
import { db } from "../../../../lib/db";
import { getUsuarioDesdeSesion } from "../../../../lib/auth";
import { agregarFotosMascotas } from "../../../../lib/fotos";
import SelectorRazaComuna from "../../../../components/SelectorRazaComuna.astro";
import GaleriaFormulario from "../../../../components/GaleriaFormulario.astro";
import EditorRecorteFoto from "../../../../components/EditorRecorteFoto.astro";

export const prerender = false;

const usuario = await getUsuarioDesdeSesion(
  Astro.cookies.get("session_id")?.value
);

if (!usuario) {
  return Astro.redirect("/login");
}

if (usuario.tipo_usuario !== "organizacion") {
  return Astro.redirect("/usuario");
}

const id = Number(Astro.params.id);

if (!Number.isSafeInteger(id) || id <= 0) {
  return Astro.redirect("/gestion/mascotas");
}


const resultado = await db.query(
  `SELECT
     id,
     foto_blob,
     nombre,
     descripcion,
     personalidad,
     personalidad_codigo,
     historial_medico,
     salud_codigo,
     tipo_mascota,
     estado_adopcion,
     publicada,
     raza,
     edad_meses,
     sexo,
     tamano,
     esterilizado,
     vacunas_al_dia,
     ubicacion,
     requisitos_adopcion
   FROM mascotas
   WHERE id = $1
     AND usuario_id = $2`,
  [id, usuario.id]
);


if (resultado.rows.length === 0) {
  return Astro.redirect("/gestion/mascotas");
}

const mascotas =
  agregarFotosMascotas(resultado.rows);

const mascota = mascotas[0];


  // Fotografías adicionales guardadas en Azure.
  // PostgreSQL almacena únicamente sus referencias.
const resultadoGaleria = await db.query(
    `SELECT id, orden
    FROM mascotas_fotos
    WHERE mascota_id = $1
    ORDER BY orden ASC`,
    [id]
);

const fotosGaleria = resultadoGaleria.rows as {
    id: number;
    orden: number;
}[];

---

<Layout
  title={`Editar ${mascota.nombre} | KodApp`}
  description="Editar una publicación de mascota."
>
  <Header />

  <main class="form-page">
    <div class="form-page-container">

      <!-- ENCABEZADO -->

      <div class="page-header">

        <a
          href="/gestion/mascotas"
          class="back-link"
        >
          <i class="fa-solid fa-arrow-left"></i>
          Volver a mis mascotas
        </a>

        <span class="section-kicker">
          Administración de publicaciones
        </span>

        <h1>Editar publicación</h1>

        <p>
          Modifica los datos de {mascota.nombre}
          y guarda los cambios.
        </p>

      </div>


      <form
        id="editar-mascota-form"
        class="publication-form"
      >

        <input
          type="hidden"
          name="id"
          value={mascota.id}
        />


        <!-- FOTO -->

        <section class="form-section">

          <div class="form-section-header">

            <span class="form-step">01</span>

            <div>
              <h2>Fotografía</h2>
              <p>Puedes mantenerla o reemplazarla.</p>
            </div>

          </div>

          <div class="upload-area">

            <label
              for="foto"
              class="upload-label"
            >

              <div
                id="preview-container"
                class="photo-preview"
              >
                {
                  mascota.foto ? (
                    <img
                      src={mascota.foto}
                      alt={`Foto de ${mascota.nombre}`}
                    />
                  ) : (
                    <>
                      <i class="fa-solid fa-camera"></i>
                      <span>Seleccionar fotografía</span>
                    </>
                  )
                }
              </div>

            </label>

            <input
              id="foto"
              name="foto"
              type="file"
              accept="image/jpeg,image/png,image/webp"
              hidden
            />
            <EditorRecorteFoto
              inputId="foto"
              previewId="preview-container"
              forma="cuadrado"
            />

            <small>
              Si no seleccionas otra imagen,
              se conserva la actual. Máximo 5 MB.
            </small>

          </div>

        </section>


        <!-- INFORMACIÓN BÁSICA -->

        <section class="form-section">

          <div class="form-section-header">

            <span class="form-step">02</span>

            <div>
              <h2>Datos de la mascota</h2>
              <p>Actualiza su información básica.</p>
            </div>

          </div>

          <div class="form-grid">

            <div class="form-field">

              <label for="nombre">
                Nombre
              </label>

              <input
                id="nombre"
                name="nombre"
                type="text"
                maxlength="100"
                required
                value={mascota.nombre}
              />

            </div>


            <div class="form-field">

              <label for="tipoMascota">
                Tipo de mascota
              </label>

              <select
                id="tipoMascota"
                name="tipoMascota"
                required
              >
                <option
                  value="perro"
                  selected={mascota.tipo_mascota === "perro"}
                >
                  Perro
                </option>

                <option
                  value="gato"
                  selected={mascota.tipo_mascota === "gato"}
                >
                  Gato
                </option>

                <option
                  value="otro"
                  selected={mascota.tipo_mascota === "otro"}
                >
                  Otro
                </option>
              </select>

            </div>


            <div class="form-field form-field-full">

              <label for="descripcion">
                Descripción
              </label>

              <textarea
                id="descripcion"
                name="descripcion"
                rows="5"
                maxlength="5000"
              >{mascota.descripcion ?? ""}</textarea>

            </div>

          </div>

        </section>


        <!-- DESPLEGABLES -->

        <ClasificacionMascota
          personalidad={mascota.personalidad}
          personalidadCodigo={mascota.personalidad_codigo}
          historialMedico={mascota.historial_medico}
          saludCodigo={mascota.salud_codigo}
        />

<!-- CARACTERÍSTICAS ADICIONALES -->

      <section class="form-section">
        <div class="form-section-header">
          <span class="form-step">05</span>
          <div>
            <h2>Características de la mascota</h2>
            <p>Actualiza los datos que verán los adoptantes.</p>
          </div>
        </div>

        <div class="form-grid">

          <!-- Mismos desplegables que al publicar -->
          <SelectorRazaComuna
            tipoId="tipoMascota"
            razaActual={mascota.raza}
            ubicacionActual={mascota.ubicacion}
          />

          <div class="form-field">
            <label for="edadMeses">Edad aproximada (meses)</label>
            <input
              id="edadMeses"
              type="number"
              name="edadMeses"
              min="0"
              max="360"
              step="1"
              value={mascota.edad_meses ?? ""}
            />
            <small>12 meses equivalen a un año.</small>
          </div>

          <div class="form-field">
            <label for="sexo">Sexo</label>
            <select id="sexo" name="sexo">
              <option
                value="desconocido"
                selected={!mascota.sexo || mascota.sexo === "desconocido"}
              >
                Sin especificar
              </option>
              <option value="macho" selected={mascota.sexo === "macho"}>
                Macho
              </option>
              <option value="hembra" selected={mascota.sexo === "hembra"}>
                Hembra
              </option>
            </select>
          </div>

          <div class="form-field">
            <label for="tamano">Tamaño</label>
            <select id="tamano" name="tamano">
              <option
                value="desconocido"
                selected={!mascota.tamano || mascota.tamano === "desconocido"}
              >
                Sin especificar
              </option>
              <option value="pequeno" selected={mascota.tamano === "pequeno"}>
                Pequeño
              </option>
              <option value="mediano" selected={mascota.tamano === "mediano"}>
                Mediano
              </option>
              <option value="grande" selected={mascota.tamano === "grande"}>
                Grande
              </option>
            </select>
          </div>

          <div class="form-field">
            <label for="esterilizado">¿Está esterilizada?</label>
            <select id="esterilizado" name="esterilizado">
              <option
                value="desconocido"
                selected={mascota.esterilizado == null}
              >
                No se sabe
              </option>
              <option value="si" selected={mascota.esterilizado === true}>
                Sí
              </option>
              <option value="no" selected={mascota.esterilizado === false}>
                No
              </option>
            </select>
          </div>

          <div class="form-field">
            <label for="vacunasAlDia">¿Tiene las vacunas al día?</label>
            <select id="vacunasAlDia" name="vacunasAlDia">
              <option
                value="desconocido"
                selected={mascota.vacunas_al_dia == null}
              >
                No se sabe
              </option>
              <option value="si" selected={mascota.vacunas_al_dia === true}>
                Sí
              </option>
              <option value="no" selected={mascota.vacunas_al_dia === false}>
                No
              </option>
            </select>
          </div>

          <div class="form-field form-field-full">
            <label for="requisitosAdopcion">
              Requisitos de adopción
            </label>
            <textarea
              id="requisitosAdopcion"
              name="requisitosAdopcion"
              maxlength="2000"
              rows="4"
              placeholder="Ej.: Tener espacio y tiempo para sus cuidados"
            >{mascota.requisitos_adopcion ?? ""}</textarea>
          </div>

        </div>
      </section>


      
        <!-- FOTOGRAFÍAS EXISTENTES -->

        <section class="form-section">
          <div class="form-section-header">
            <span class="form-step">06</span>
            <div>
              <h2>Fotografías actuales</h2>
              <p>
                Selecciona las fotos que quieras quitar.
                Los cambios se aplicarán al guardar.
              </p>
            </div>
          </div>

          {fotosGaleria.length === 0 ? (
            <p class="galeria-vacia">
              Esta mascota no tiene fotografías adicionales.
            </p>
          ) : (
            <div class="galeria-existente">

              {fotosGaleria.map((foto) => (
                <label class="foto-existente">
                  <img
                    src={`/api/fotos/galeria/${foto.id}`}
                    alt={`Fotografía adicional ${foto.orden}`}
                    loading="lazy"
                  />

                  <span class="foto-quitar">
                    <input
                      type="checkbox"
                      name="fotosEliminar"
                      value={foto.id}
                    />
                    Quitar al guardar
                  </span>
                </label>
              ))}

            </div>
          )}
        </section>

        <!-- NUEVAS FOTOGRAFÍAS -->

        <GaleriaFormulario />



        <!-- ESTADO DE ADOPCIÓN -->

        <section class="form-section">

          <div class="form-section-header">

            <span class="form-step">08</span>

            <div>
              <h2>Estado de adopción</h2>

              <p>
                Indica si la mascota continúa
                disponible para postulaciones.
              </p>
            </div>

          </div>

          <div class="form-field">

            <label for="estadoAdopcion">
              Estado
            </label>

            <select
              id="estadoAdopcion"
              name="estadoAdopcion"
              required
            >
              <option
                value="disponible"
                selected={
                  mascota.estado_adopcion === "disponible"
                }
              >
                Disponible
              </option>

              <option
                value="reservada"
                selected={
                  mascota.estado_adopcion === "reservada"
                }
              >
                Reservada
              </option>

              <option
                value="adoptada"
                selected={
                  mascota.estado_adopcion === "adoptada"
                }
              >
                Adoptada
              </option>
            </select>

          </div>

        </section>


        <!-- MENSAJE -->

        <p
          id="editar-mensaje"
          class="form-message"
          role="status"
          aria-live="polite"
        ></p>


        <!-- BOTONES -->

        <div class="form-actions">

          <button
            id="eliminar-publicacion"
            type="button"
            class="btn-eliminar-publicacion"
          >
            <i class="fa-solid fa-trash"></i>
            Ocultar publicación
          </button>

          <a
            href="/gestion/mascotas"
            class="btn-outline"
          >
            Cancelar
          </a>

          <button
            id="guardar-cambios"
            type="submit"
            class="btn-primary"
          >
            <i class="fa-solid fa-floppy-disk"></i>
            Guardar cambios
          </button>

        </div>

      </form>

    </div>
  </main>
</Layout>


<script>
  const form =
    document.querySelector<HTMLFormElement>(
      "#editar-mascota-form"
    );


  const mensaje =
    document.querySelector<HTMLElement>(
      "#editar-mensaje"
    );

  const botonGuardar =
    document.querySelector<HTMLButtonElement>(
      "#guardar-cambios"
    );

  const botonEliminar =
    document.querySelector<HTMLButtonElement>(
      "#eliminar-publicacion"
    );


  // ==========================================
  // VISTA PREVIA DE LA FOTO
  // ==========================================




  // ==========================================
  // GUARDAR CAMBIOS
  // ==========================================

  form?.addEventListener("submit", async (evento) => {
    evento.preventDefault();

    if (!form || !botonGuardar || !mensaje) {
      return;
    }

    if (!form.reportValidity()) {
      return;
    }

    // Contar las fotografías actuales que se conservarán.
    const casillas = Array.from(
      form.querySelectorAll<HTMLInputElement>(
        'input[name="fotosEliminar"]'
      )
    );

    const fotosConservadas = casillas.filter(
      (casilla) => !casilla.checked
    ).length;

    // Contar las nuevas fotografías seleccionadas.
    const entradaGaleria =
      form.querySelector<HTMLInputElement>("#galeria");

    const nuevasFotos = entradaGaleria?.files?.length ?? 0;

    // La galería admite máximo 4 fotos adicionales.
    if (fotosConservadas + nuevasFotos > 4) {
      mensaje.textContent =
        `Puedes tener máximo 4 fotografías adicionales. ` +
        `Actualmente conservarías ${fotosConservadas} ` +
        `y agregarías ${nuevasFotos}.`;

      return;
    }


    botonGuardar.disabled = true;
    mensaje.textContent = "Guardando cambios...";

    try {
      const respuesta = await fetch(
        "/api/mascotas/editar",
        {
          method: "POST",
          credentials: "same-origin",
          body: new FormData(form)
        }
      );

      const resultado = await respuesta.json();

      if (respuesta.status === 401) {
        window.location.href = "/login";
        return;
      }

      if (!respuesta.ok || !resultado.ok) {
        mensaje.textContent =
          resultado.mensaje ||
          "No se pudieron guardar los cambios.";
        return;
      }

      window.location.href = "/gestion/mascotas";

    } catch (error) {
      console.error("Error al editar mascota:", error);

      mensaje.textContent =
        "No se pudo conectar con el servidor.";

    } finally {
      botonGuardar.disabled = false;
    }
  });


  // ==========================================
  // ELIMINAR PUBLICACIÓN
  // ==========================================

  botonEliminar?.addEventListener("click", async () => {
    if (!form || !mensaje || !botonEliminar) {
      return;
    }

    const idInput =
      form.querySelector<HTMLInputElement>(
        'input[name="id"]'
      );

    const id = Number(idInput?.value);

    if (!Number.isSafeInteger(id) || id <= 0) {
      mensaje.textContent =
        "ID de publicación inválido.";
      return;
    }

    const confirmado = window.confirm(
      "¿Quieres ocultar esta mascota del catálogo?\n\n" +
      "No aparecerá en Mascotas disponibles ni en Match.\n" +
      "Las postulaciones, los datos y las fotografías se conservarán para consevar el historial"
    );

    if (!confirmado) {
      return;
    }

    botonEliminar.disabled = true;

    if (botonGuardar) {
      botonGuardar.disabled = true;
    }

    mensaje.textContent = "Ocultando publicación...";

    try {
      const respuesta = await fetch(
        "/api/mascotas/eliminar",
        {
          method: "DELETE",
          credentials: "same-origin",
          headers: {
            "Content-Type": "application/json"
          },
          body: JSON.stringify({ id })
        }
      );

      const resultado = await respuesta.json();

      if (!respuesta.ok || !resultado.ok) {
        mensaje.textContent =
          resultado.mensaje ||
          "No se pudo eliminar la publicación.";
        return;
      }

      if (resultado.advertencia) {
        window.alert(resultado.mensaje);
      }

      window.location.href = "/gestion/mascotas";

    } catch (error) {
      console.error("Error al eliminar:", error);

      mensaje.textContent =
        "No se pudo conectar con el servidor.";

    } finally {
      botonEliminar.disabled = false;

      if (botonGuardar) {
        botonGuardar.disabled = false;
      }
    }
  });
</script>


<style>
  .galeria-existente {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(155px, 1fr));
    gap: 16px;
    margin-top: 16px;
  }

  .foto-existente {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid #4b5563;
    border-radius: 14px;
    background: #222b36;
    cursor: pointer;
  }

  .foto-existente img {
    width: 100%;
    height: 165px;
    object-fit: cover;
  }

  .foto-quitar {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 12px;
    font-size: 13px;
    color: #f5f5f5;
  }

  .foto-quitar input {
    width: 17px;
    height: 17px;
    accent-color: #e45d6f;
  }

  .foto-existente:has(input:checked) {
    border-color: #e45d6f;
    opacity: 0.65;
  }

  .galeria-vacia {
    color: #aeb8c6;
  }

  @media (max-width: 600px) {
    .galeria-existente {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
